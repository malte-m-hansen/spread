<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Spread</AssemblyName>
    <RootNamespace>Spread</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No Spread.exe launcher: it is never used (run with 'dotnet Spread.dll') and each unsigned build of it trips Defender's
         'unproven executable' rule whenever Explorer is asked to start it. -->
    <UseAppHost>false</UseAppHost>
    <!-- Claude Code keeps temporary git worktrees (full copies of this project) under .claude\: never compile those. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.claude/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
